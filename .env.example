# Copy to .env and `chmod 600 .env`. Never commit .env.

# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Fernet key used to encrypt game tokens at rest. Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing or changing it makes stored tokens unreadable (users must /link again).
ENCRYPTION_KEY=

# Optional: your Discord server's ID. Slash commands appear there instantly, and only
# admins of this server can change the clan token. Leave empty to sync globally.
GUILD_ID=

# Optional: log level (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO

# Optional: your clan's tag (e.g. NPC). Only characters in this clan appear on the
# highscores, the clan feed and /topgains. Leave empty to include every linked character.
# Ignored while a clan token is loaded (/link-clan): then the token's own clan is used.
CLAN_TAG=

# Optional: how often (minutes, min 5) the clan highscores re-fetch each linked
# player's profile. Each refresh costs one API call per player, against that
# player's own 240/hour limit. Default 15.
HIGHSCORES_REFRESH_MINUTES=15

# Optional: when the game's week resets (UTC). The weekly top gainers card posts
# then, covering the week just ended. Defaults: Monday, hour 0.
WEEKLY_RESET_DAY=Monday
WEEKLY_RESET_HOUR=0

# Optional: set to 1 to add 8 made-up players to the highscores, to preview full
# boards. They are never stored; remove the line and restart to go back.
HIGHSCORES_DEMO=

# The clan's API token isn't set here: an admin runs /link-clan in Discord
# (/clear-clan removes it). The highscores, feed and /topgains then count that
# token's clan.
