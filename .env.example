# Copy to .env and `chmod 600 .env`. Never commit .env.

# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Fernet key used to encrypt game tokens at rest. Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing or changing it makes stored tokens unreadable (users must /link again).
ENCRYPTION_KEY=

# Optional: your Discord server's ID, to register slash commands there instantly
# (handy while testing). Commands then appear ONLY in that server, so leave it
# empty if this bot serves several servers.
GUILD_ID=

# Optional: the only servers this bot may be in, as IDs separated by commas. If
# someone adds it to any other server, it leaves straight away. Empty = any server.
ALLOWED_GUILDS=

# Optional: a custom status under the bot's name in the member list,
# e.g. "Problems? Message <your name> in game".
BOT_STATUS=

# Optional: log level (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO

# Optional: your clan's tag (e.g. MOSS). Only characters in this clan appear on the
# highscores, the clan feed and /topgains. Leave empty to include every linked character.
# Only used by servers that haven't linked a clan token (/link-clan); each server
# that has counts its own clan.
CLAN_TAG=

# Optional: how often (minutes, min 5) the clan highscores re-fetch each linked
# player's profile. Each refresh costs one API call per player, against that
# player's own 240/hour limit. Default 15.
HIGHSCORES_REFRESH_MINUTES=15

# Optional: when the game's week resets (UTC). The weekly top gainers card posts
# then, covering the week just ended. Defaults: Monday, hour 0.
WEEKLY_RESET_DAY=Monday
WEEKLY_RESET_HOUR=0

# Optional: set to 1 to add 8 made-up players to the highscores, to preview full
# boards. They are never stored; remove the line and restart to go back.
HIGHSCORES_DEMO=

# Clan API tokens aren't set here: each server's admins run /link-clan in Discord
# (/clear-clan removes it). That server's highscores, feed and /topgains then count
# that clan, and its clan channels get that clan's boss, bank and research.
